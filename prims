#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    vector<vector<pair<int, int>>> adj(n);

    for (int i = 0; i < m; i++) {
        int u, v, wt;
        cin >> u >> v >> wt;

        adj[u].push_back({v, wt});
        adj[v].push_back({u, wt});
    }

    vector<int> visited(n, 0);

    // {weight, node}
    priority_queue<pair<int, int>,
                   vector<pair<int, int>>,
                   greater<pair<int, int>>> pq;

    pq.push({0, 0});

    int mstWeight = 0;

    while (!pq.empty()) {
        auto [wt, node] = pq.top();
        pq.pop();

        if (visited[node])
            continue;

        visited[node] = 1;
        mstWeight += wt;

        for (auto [nextNode, edgeWeight] : adj[node]) {
            if (!visited[nextNode]) {
                pq.push({edgeWeight, nextNode});
            }
        }
    }

    cout << "MST Weight = " << mstWeight << endl;

    return 0;
}
