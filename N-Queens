#include <iostream>
#include <vector>
using namespace std;

int n;

bool safe(vector<int>& board, int row, int col) {
    for (int i = 0; i < row; i++)
        if (board[i] == col ||
            abs(board[i] - col) == abs(i - row))
            return false;
    return true;
}

bool solve(vector<int>& board, int row) {
    if (row == n) return true;

    for (int col = 0; col < n; col++) {
        if (safe(board, row, col)) {
            board[row] = col;
            if (solve(board, row + 1)) return true;
            board[row] = -1;
        }
    }
    return false;
}

int main() {
    cin >> n;
    vector<int> board(n, -1);

    if (solve(board, 0)) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++)
                cout << (board[i] == j ? "Q " : ". ");
            cout << '\n';
        }
    } else {
        cout << "No solution exists";
    }
    return 0;
}
