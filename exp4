
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

struct Edge {
    int u, v, w;
};

bool cmp(Edge a, Edge b) {
    return a.w < b.w;
}

int parent[1000];

int find(int x) {
    if (parent[x] == x) return x;
    return parent[x] = find(parent[x]);
}

int main() {
    int V, E, cost = 0;
    cin >> V >> E;

    vector<Edge> edges(E);
    for (int i = 0; i < E; i++)
        cin >> edges[i].u >> edges[i].v >> edges[i].w;

    sort(edges.begin(), edges.end(), cmp);

    for (int i = 0; i < V; i++)
        parent[i] = i;

    for (auto e : edges) {
        int a = find(e.u), b = find(e.v);

        if (a != b) {
            cout << e.u << " - " << e.v
                 << " : " << e.w << '\n';
            cost += e.w;
            parent[a] = b;
        }
    }

    cout << "Minimum cost = " << cost;
    return 0;
}
